# Sambal & Sakura — environment template.
# Copy the lines you need into .env. Everything below is OPTIONAL: the site runs
# fully without any of it (cash orders, local-disk photo uploads, print-from-browser).

# ----------------------------------------------------------------------------
# Database (already set by the app)
# DATABASE_URL="file:./dev.db"

# ----------------------------------------------------------------------------
# MENU PHOTO UPLOADS
# Default with nothing set: photos save to /public/uploads (free, works on a VPS).
# Cheapest + best for production: Cloudinary (free 25GB, auto-optimising CDN).
#   1. Create a free account at cloudinary.com
#   2. Dashboard → copy the cloud name, API key and API secret (signed uploads: only this server can upload)
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="123456789012345"
# CLOUDINARY_API_SECRET="your-api-secret"
# (Older option, less safe: an UNSIGNED upload preset that anyone who learns its name can use)
# CLOUDINARY_UPLOAD_PRESET="your-unsigned-preset"

# ----------------------------------------------------------------------------
# KITCHEN PRINTER: the Xprinter XP-E260M plugs into the kitchen tablet by USB and prints from
# Admin -> Orders (Connect printer). Nothing to set here.
#
# OPTIONAL BACKUP: PrintNode (a printer on a PC at the till)
# Works with almost any USB/network receipt printer. ~£10/mo.
#   1. Sign up at printnode.com, install their client on the till PC
#   2. Copy your API key and the numeric printer id
# PRINTNODE_API_KEY="your-printnode-api-key"
# PRINTNODE_PRINTER_ID="12345"
# (Orders also print on demand from Admin → Orders → Print ticket, no setup needed.)

# ----------------------------------------------------------------------------
# SITE TRANSLATION (auto-translate the whole site into 中文 / Tiếng Việt / 日本語)
# The engine caches every translation in the DB, so you only pay for each unique
# string once. Pick ONE provider (checked in this order). Without any key, the UI
# still auto-detects language and translates the built-in terms (nav, buttons),
# but body text stays English until a provider is configured.
#   Cheapest + best coverage — Google Cloud Translation (500k chars/mo free):
# GOOGLE_TRANSLATE_API_KEY="your-google-api-key"
#   Alternative — Microsoft Translator (2M chars/mo free for 12 months):
# MICROSOFT_TRANSLATOR_KEY="your-ms-key"
# MICROSOFT_TRANSLATOR_REGION="uksouth"
#   Free / self-hosted — LibreTranslate:
# LIBRETRANSLATE_URL="https://your-libretranslate-host"
# LIBRETRANSLATE_API_KEY="optional"

# ----------------------------------------------------------------------------
# "ASK ABOUT THIS DISH" AI ASSISTANT (Groq)
# Powers the question box on each menu item. Get a free key at console.groq.com.
# GROQ_API_KEY="gsk_..."
# Default model is openai/gpt-oss-120b; override if your key has a different one:
# GROQ_MODEL="openai/gpt-oss-120b"

# ----------------------------------------------------------------------------
# WECHAT PAY (shown automatically to Chinese-language customers)
# From your WeChat Pay merchant account (pay.weixin.qq.com). Needed to TAKE payment:
# WECHAT_APPID="wx..."                   # official account / app id
# WECHAT_MCHID="16000..."                # merchant id
# WECHAT_SERIAL_NO="your-cert-serial"    # API certificate serial number
# WECHAT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# WECHAT_NOTIFY_URL="https://YOUR-DOMAIN/api/pay/wechat/notify"
# Needed to CONFIRM payment (WeChat calls /api/pay/wechat/notify after the customer pays).
# Without these two the site never marks WeChat orders as paid, so set all of them together:
# WECHAT_API_V3_KEY="32-character-apiv3-key"
# WECHAT_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ----------------------------------------------------------------------------
# GETTING FOUND ON GOOGLE (see DEPLOY.md)
# SITE_URL="https://sambalandsakura.co.uk"        # the address the site is really served from
# GOOGLE_SITE_VERIFICATION="code-from-search-console"
# BING_SITE_VERIFICATION="code-from-bing-webmaster-tools"

# ----------------------------------------------------------------------------
# CUSTOMER EMAILS (Brevo): order received / on its way / ready / completed / cancelled, booking
# confirmations + day-before reminders, account emails, and offer emails from Admin → Promotions.
# Free plan: 300 emails/day. Sender must be on a domain you've verified in Brevo (see DEPLOY.md).
# BREVO_API_KEY="xkeysib-..."
# EMAIL_FROM="orders@sambalandsakura.co.uk"
# EMAIL_FROM_NAME="Sambal & Sakura"
# Careers-page applications (CV attached) go here; default = the email in Admin → Site content.
# CAREERS_EMAIL="jobs@sambalandsakura.co.uk"
# EMAIL_DAILY_LIMIT="300"     # raise if you move to a paid Brevo plan
# SESSION_SECRET="long-random-string"   # Render generates this. Signs unsubscribe links: never change it once live.

# ----------------------------------------------------------------------------
# PROTECTION AGAINST ABUSE (see DEPLOY.md "Security switches")
# Bot check on guest checkout, sign-up and bookings (Cloudflare Turnstile, free).
# Test keys that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY="0x4AAAA..."
# TURNSTILE_SECRET_KEY="0x4AAAA..."
# Push alerts to the owner's phone (failed print, order not picked up, WeChat refund needed...).
# Free: install the ntfy app, pick a long secret topic name, then:
# ALERT_WEBHOOK_URL="https://ntfy.sh/sambal-sakura-<long-random-secret>"
# Which header holds the visitor's real IP. Leave unset unless Admin → Settings → Connection check
# shows the wrong address (then set it to the header that shows your real one, e.g. cf-connecting-ip).
# CLIENT_IP_HEADER="cf-connecting-ip"
# Daily cap on characters sent to the paid translation service (protects the bill). Default 200000.
# TRANSLATE_DAILY_CHAR_BUDGET="200000"
# Personal details are removed from old orders/bookings after this many days (defaults 730 / 365).
# ORDER_PII_RETENTION_DAYS="730"
# BOOKING_PII_RETENTION_DAYS="365"

# ----------------------------------------------------------------------------
# PRODUCTION ONLY (Render) - see DEPLOY.md
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&connection_limit=5"   # Neon pooled string (host has -pooler)
# ADMIN_EMAIL="owner@yourrestaurant.co.uk"     # first-deploy owner login (created once, never overwritten)
# ADMIN_PASSWORD="at-least-12-characters"     # remove it from Render after the first deploy
