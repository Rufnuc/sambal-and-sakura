// Sambal & Sakura — data model. SQLite for local dev; swap the datasource to
// PostgreSQL for production (models are portable).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  phone        String
  passwordHash String
  role         String    @default("customer") // customer | staff | admin
  permissions  String    @default("[]") // JSON array of admin section keys (staff only)
  points       Int       @default(0)
  referralCode String    @unique
  createdAt    DateTime  @default(now())
  // Account lifecycle: active → deactivated (can reactivate for 14 days) → closed (permanent,
  // personal details removed, email blocked from signing up again via BlockedEmail).
  status           String    @default("active") // active | deactivated | closed
  deactivatedAt    DateTime?
  closedAt         DateTime?
  // Promotional emails only with explicit consent (UK PECR); every email has an unsubscribe link.
  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?
  locale           String    @default("en") // email language: en | zh | vi | ja (last used on the site)
  // Set when they click the link in the sign-up email (or complete a password reset, which proves the same).
  // Ordering never waits for it; marketing emails do.
  emailVerifiedAt  DateTime?
  // Prepaid balance: only for customers the owner offers it to, and usable only once they've accepted
  // the separate prepaid-balance terms (server/balance.ts). Money is kept in pence so it never drifts.
  balanceStatus          String    @default("none") // none | offered | active | declined
  balancePence           Int       @default(0)
  balanceDiscountPct     Float     @default(0)      // % off the food on orders paid from the balance (set per customer)
  balanceTermsVersion    String?                    // the version of the prepaid-balance terms they accepted
  balanceTermsAcceptedAt DateTime?

  orders        Order[]
  bookings      Booking[]
  rewards       Reward[]
  sessions      Session[]
  pointsEntries PointsEntry[]
  wheel         WheelState?
  referralsMade Referral[]  @relation("referralsMade")
  referredBy    Referral?   @relation("referredBy")
  authTokens    AuthToken[]
  balanceEntries BalanceEntry[]
}

// Every change to a customer's prepaid balance: money added, spent on an order or eat-in bill, refunded.
model BalanceEntry {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountPence       Int      // + money in, - money out
  kind              String   // topup | order | dine-in | refund | reversal
  orderId           String?
  method            String?  // how money came in or went back: cash | card | bank
  note              String?
  staffEmail        String?  // who did it (staff actions)
  balanceAfterPence Int
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
}

// One-time links emailed to a customer: "confirm your email" and "reset your password".
model AuthToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // SHA-256 of the link's token; the raw token is only in the email
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String    // verify | reset
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

model Session {
  id         String   @id @default(cuid())
  token      String   @unique // SHA-256 of the cookie value; the raw token is never stored
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now()) // staff sessions also expire after a period of inactivity
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Order {
  id            String      @id
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String
  customerEmail String?
  fulfilment    String      // delivery | collection
  status        String      @default("received")
  subtotal      Float
  deliveryFee   Float       @default(0)
  discount      Float       @default(0)        // every discount on the order (online discount + any code)
  onlineDiscount      Float   @default(0)        // the part of `discount` that is the online order discount
  onlineDiscountLabel String?                    // e.g. "Online order discount (10%)", as it was when ordered
  balanceDiscount Float   @default(0)              // the customer's prepaid-balance % (part of `discount`)
  balancePaid   Float     @default(0)              // taken from the prepaid balance; the rest of `total` is paid as normal
  handoverCode  String?                          // 4 digits the customer gives the driver / counter (kitchen ticket only, never the bag receipt)
  total         Float
  voucherCode   String?
  address       String?
  postcode      String?
  notes         String?
  whenType      String      @default("asap") // asap | scheduled
  scheduledTime String?                      // display label, e.g. "Sat 11 Oct 19:00"
  scheduledAt   DateTime?                    // the exact time a scheduled order is for
  etaMins       Int         @default(25)
  pointsEarned  Int         @default(0)
  paymentMethod String      @default("cash")   // cash | wechat
  paymentStatus String      @default("unpaid") // unpaid | paid (cash orders are settled in person)
  paymentRef    String?                        // provider transaction id (e.g. WeChat transaction_id)
  paidAt        DateTime?
  payToken      String?                        // SHA-256 of the token that lets this browser start/poll payment
  idempotencyKey String?    @unique            // one checkout attempt = one order, however often it is retried
  printStatus   String      @default("pending") // pending | printed | failed | not-needed
  printAttempts Int         @default(0)
  printedAt     DateTime?
  printError    String?
  flags         String      @default("[]")     // JSON array, e.g. ["new-customer","address-unverified"]
  locale        String      @default("en")     // language the customer ordered in (their emails use it)
  cancelReason  String?
  cancelKind    String?                        // customer | no-show | staff (customer + no-show count towards limits)
  cancelledAt   DateTime?
  cancelPrintedAt DateTime?                    // the kitchen's "CANCELLED - STOP" ticket was printed (cloud or tablet)
  cancelCounted Boolean     @default(true)     // false once the owner resets this customer's cancellations
  createdAt     DateTime    @default(now())

  lines OrderLine[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([customerPhone])
  @@index([customerEmail])
  @@index([printStatus])
  @@index([status, cancelledAt])
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    String
  name      String
  unitPrice Float
  qty       Int
  modifiers String  @default("[]") // JSON array of {groupId,optionId,label}

  @@index([orderId])
}

model Booking {
  id        String   @id
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  phone     String
  email     String?
  date      String   // YYYY-MM-DD
  time      String   // HH:MM
  party     Int
  status    String   @default("upcoming")
  tableId   String?
  occasion  String?
  dietary   String?
  notes     String?
  requiresCall Boolean @default(false) // large party: staff phone to confirm and take the deposit
  reminderSentAt DateTime? // day-before reminder email
  locale    String   @default("en") // email language
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([date])
  @@index([phone, date])
  @@index([email])
}

model Reward {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  code      String    @unique
  kind      String    // percent | voucher | freebie
  amount    Float?
  minSpend  Float?    // food total needed before it applies (referral rewards)
  source    String    // welcome | wheel | referral (referrer) | referral-welcome (new friend) | loyalty
  used      Boolean   @default(false)
  usedAt    DateTime?
  orderId   String?   // the order that used it
  createdAt DateTime  @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([userId, used])
}

// Loyalty ledger. Points from an order stay "pending" until staff mark the order completed,
// and are reversed if it is cancelled. User.points is the confirmed, spendable balance.
model PointsEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String   // welcome | order | redeem | reversal | adjustment
  status    String   // pending | confirmed | reversed
  orderId   String?
  createdAt DateTime @default(now())

  @@index([userId, status])
  @@index([orderId])
}

// One row per customer: when they last spun the Fortune Wheel (claimed atomically).
model WheelState {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSpinAt DateTime
}

// "One per customer" offers (first-order codes, the welcome reward), keyed by normalised phone,
// so guests and new accounts can't reuse them. The unique key makes the claim atomic.
model VoucherRedemption {
  id        String   @id @default(cuid())
  group     String   // e.g. "first-order"
  phoneKey  String
  orderId   String   @unique
  createdAt DateTime @default(now())

  @@unique([group, phoneKey])
}

// Fixed-window rate-limit counters (key includes the window number).
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// Who changed what in the admin, and security-relevant events.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String   // e.g. order.status, booking.update, staff.create, config.save, login.failed
  entity     String
  entityId   String?
  detail     String?  // JSON
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorEmail])
}

// First-party analytics events (only sent after the visitor accepts analytics cookies).
model Event {
  id        String   @id @default(cuid())
  name      String
  props     String   @default("{}")
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
}

// Operator settings (blackout dates, disabled zones, etc.) as key/JSON rows.
model Setting {
  key   String @id
  value String // JSON
}

// Persistent machine-translation cache: each English string is translated once
// per locale, then reused forever (fast + effectively free after first hit).
model Translation {
  id        String   @id @default(cuid())
  locale    String   // zh | vi | ja
  hash      String   // sha256 of the source text
  source    String   // original English text
  value     String   // translated text
  createdAt DateTime @default(now())

  @@unique([locale, hash])
  @@index([locale])
}

// Emails that can never be used to sign up again (closed accounts). Stored as a keyed one-way
// fingerprint (HMAC), not the address itself, so the person's email isn't kept.
model BlockedEmail {
  hash      String   @id
  reason    String   // closed | deleted
  createdAt DateTime @default(now())
}

// Every email the site tries to send. `key` makes transactional emails send once only
// (e.g. "order:SS-ABC123:received"); counts also enforce the daily sending budget.
model EmailLog {
  id         String   @id @default(cuid())
  kind       String   // transactional | marketing
  template   String
  key        String?  @unique
  campaignId String?
  status     String   // sent | failed
  error      String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
}

// Promotional emails written in Admin → Promotions. Sent in daily batches so they never use up
// the allowance that order and booking emails need.
model Campaign {
  id         String   @id @default(cuid())
  subject    String
  body       String
  audience   String   // all | selected
  translations String @default("{}") // JSON {zh|vi|ja: {subject, body}}; customers in that language get it
  imageUrl   String?  // picture shown inside the email (Cloudinary URL)
  fileUrl    String?  // a file (e.g. PDF menu) recipients open with a button
  fileName   String?  // button label / file name for fileUrl
  status     String   @default("queued") // queued | sending | sent | cancelled
  total      Int      @default(0)
  sent       Int      @default(0)
  failed     Int      @default(0)
  createdBy  String
  createdAt  DateTime @default(now())
  finishedAt DateTime?

  recipients CampaignRecipient[]
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  status     String    @default("pending") // pending | sent | failed | skipped
  sentAt     DateTime?

  @@unique([campaignId, userId])
  @@index([campaignId, status])
  @@index([userId])
}


// "Refer a friend". Created when a new customer signs up with someone's code (the friend gets their
// reward straight away, usable on a first order only). The referrer is rewarded only when the friend's
// first COMPLETED order reaches the minimum spend, from a different phone and address.
model Referral {
  id              String    @id @default(cuid())
  referrerId      String
  referrer        User      @relation("referralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId       String    @unique // a customer can only ever be referred once
  referee         User      @relation("referredBy", fields: [refereeId], references: [id], onDelete: Cascade)
  code            String    // the code they used
  refereePhoneKey String    // one referral per phone number, even across accounts
  status          String    @default("pending") // pending | rewarded | void
  orderId         String?   // the friend's qualifying order
  rewardId        String?   // the referrer's reward
  voidReason      String?
  createdAt       DateTime  @default(now())
  rewardedAt      DateTime?

  @@index([referrerId, status])
  @@index([refereePhoneKey])
  @@index([orderId])
}
